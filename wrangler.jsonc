{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wormholeapp",
  "main": "./worker.js",
  "compatibility_date": "2026-08-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
