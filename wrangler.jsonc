{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wormholeapp",
  "main": "./worker.js",
  "compatibility_date": "2026-08-21",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "TWITCH_CLIENT_ID": "wigwgqcieffev63tiiwq6j3dozv4o5"
  }
}
